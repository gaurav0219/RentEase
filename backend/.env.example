# Database (use your Neon/Supabase connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT Configuration (generate strong random strings!)
JWT_SECRET="generate-a-64-char-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="generate-another-64-char-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Configuration
PORT=3001
NODE_ENV=production

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS - set to your Vercel/Netlify URL)
FRONTEND_URL="https://your-app.vercel.app"
